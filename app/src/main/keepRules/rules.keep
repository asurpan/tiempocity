# Keep all data models for Gson serialization/deserialization
-keep class com.example.tiempocity.data.model.** { *; }
-keepclassmembers class com.example.tiempocity.data.model.** { *; }

# Keep Retrofit interface and network models
-keep class com.example.tiempocity.data.network.** { *; }
-keepclassmembers interface com.example.tiempocity.data.network.** { *; }

# Retrofit & Gson rules
-keep class retrofit2.** { *; }
-keepclassmembers class * {
    @retrofit2.http.** <methods>;
}
-keep class com.google.gson.** { *; }

# Glance & WorkManager
-keep class com.example.tiempocity.widget.** { *; }
-keep class com.example.tiempocity.notification.** { *; }
